<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0">
<title>Ledger · Personal Finance Tracker</title>

<link rel="manifest" href="manifest.json">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Ledger">
<link rel="apple-touch-icon" href="icons/icon-192.png">
<meta name="theme-color" content="#1C2A44">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@500;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<script>
  // Multi-source fallback for the chart library: try each URL in turn, first one to
  // succeed wins. Keeps the app usable even if one CDN is blocked or unreachable.
  window.chartLibReady = (function () {
    var urls = [
      'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js',
      'https://cdn.staticfile.org/Chart.js/4.4.4/chart.umd.min.js',
      'https://cdn.bootcdn.net/ajax/libs/Chart.js/4.4.4/chart.umd.min.js',
      'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js'
    ];
    function tryLoad(i) {
      return new Promise(function (resolve) {
        if (i >= urls.length) { resolve(false); return; }
        var s = document.createElement('script');
        s.src = urls[i];
        var settled = false;
        var timer = setTimeout(function () { if (!settled) { settled = true; tryLoad(i + 1).then(resolve); } }, 4000);
        s.onload = function () {
          if (settled) return; settled = true; clearTimeout(timer);
          if (typeof Chart !== 'undefined') resolve(true);
          else tryLoad(i + 1).then(resolve);
        };
        s.onerror = function () {
          if (settled) return; settled = true; clearTimeout(timer);
          tryLoad(i + 1).then(resolve);
        };
        document.head.appendChild(s);
      });
    }
    return tryLoad(0);
  })();
</script>
<link rel="stylesheet" href="styles.css">
</head>
<body>
<div id="app">

  <!-- ============ HOME ============ -->
  <div class="page active" id="page-home">
    <div class="topbar">
      <h1>Ledger</h1>
      <select class="month-select" id="monthSelect"></select>
    </div>
    <div style="padding:16px;">
      <div class="card-hero">
        <div class="label">Net Balance This Month</div>
        <div class="value" id="heroNet">$0.00</div>
        <div class="sub">
          <span>Income <span id="heroIncome">$0</span></span>
          <span>Expenses <span id="heroExpense">$0</span></span>
          <span>Debt <span id="heroDebt">$0</span></span>
        </div>
      </div>

      <div class="cards-row">
        <div class="card">
          <div class="label">Budget Remaining</div>
          <div class="value" id="cardBudgetLeft">$0</div>
          <div class="foot" id="cardBudgetFoot">—</div>
        </div>
        <div class="card">
          <div class="label">Savings Progress</div>
          <div class="value" id="cardSaving">$0</div>
          <div class="foot" id="cardSavingFoot">—</div>
        </div>
      </div>

      <section class="panel">
        <h2>This Month's Recurring Bills <span class="hint">occurred vs. upcoming, as of today</span></h2>
        <div id="homeRecurringStatus"></div>
      </section>

      <section class="panel">
        <h2>Expense Overview <span class="hint">tracked against budget</span></h2>
        <div id="homeCatList"></div>
      </section>

      <section class="panel">
        <h2>Income Breakdown</h2>
        <div id="homeIncomeList"></div>
      </section>

      <section class="panel">
        <h2>Debt Overview <span class="hint">mortgage, car loan, etc.</span></h2>
        <div id="homeDebtList"></div>
      </section>

      <section class="panel">
        <h2>Recent Transactions</h2>
        <div id="homeRecentList"></div>
      </section>
    </div>
  </div>

  <!-- ============ CHARTS ============ -->
  <div class="page" id="page-chart">
    <div class="topbar">
      <h1>Charts</h1>
      <div class="seg" id="chartRangeSeg" style="max-width:180px;">
        <button type="button" data-val="monthly" class="active">Monthly</button>
        <button type="button" data-val="yearly">Yearly</button>
      </div>
    </div>

    <!-- Monthly -->
    <div id="chartMonthly" style="padding:16px;">
      <div style="margin-bottom:12px;"><select class="month-select" id="monthSelectChart"></select></div>
      <section class="panel">
        <h2>Spending Summary <span class="hint">Expenses vs. Savings vs. Debt</span></h2>
        <canvas id="spendingSummaryChart" height="90"></canvas>
      </section>
      <section class="panel">
        <h2>Income Breakdown <span class="hint">expected vs. actual</span></h2>
        <canvas id="incomeBreakdownChart" height="200"></canvas>
      </section>
      <section class="panel">
        <h2>This Month's Spending Breakdown</h2>
        <canvas id="pieChart" height="220"></canvas>
      </section>
      <section class="panel">
        <h2>Daily Spending Trend</h2>
        <canvas id="trendChart" height="180"></canvas>
      </section>
    </div>

    <!-- Yearly -->
    <div id="chartYearly" style="padding:16px; display:none;">
      <div style="margin-bottom:12px;"><select class="month-select" id="yearSelect"></select></div>
      <div class="cards-row" style="grid-template-columns:repeat(2,1fr);">
        <div class="card"><div class="label">Total Income</div><div class="value" id="yearIncome">$0</div></div>
        <div class="card"><div class="label">Total Expenses</div><div class="value" id="yearExpense">$0</div></div>
        <div class="card"><div class="label">Total Savings</div><div class="value" id="yearSaving">$0</div></div>
        <div class="card"><div class="label">Total Debt</div><div class="value" id="yearDebt">$0</div></div>
      </div>
      <section class="panel">
        <h2>Budgeted vs. Actual <span class="hint">full-year budget target</span></h2>
        <canvas id="yearlyBudgetChart" height="200"></canvas>
      </section>
      <section class="panel">
        <h2>12-Month Trend</h2>
        <canvas id="yearlyTrendChart" height="220"></canvas>
      </section>
      <section class="panel">
        <h2>Biggest Budget Gaps <span class="hint">categories furthest from their annual target</span></h2>
        <div id="yearlyGapsList"></div>
      </section>
    </div>
  </div>

  <!-- ============ CATEGORIES ============ -->
  <div class="page" id="page-categories">
    <div class="topbar">
      <h1>Categories</h1>
    </div>
    <div style="padding:16px;">
      <div id="catManageTree"></div>

      <section class="panel" style="margin-top:16px;">
        <h2>Add Category</h2>
        <form id="addCatForm">
          <div class="form-row">
            <label>Parent Category</label>
            <select id="newCatParent"></select>
          </div>
          <div class="form-row">
            <label>Category Name</label>
            <input type="text" id="newCatName" required placeholder="e.g. Health">
          </div>
          <div class="form-row" id="newCatBudgetRow">
            <label>Monthly Budget ($, optional)</label>
            <input type="number" id="newCatBudget" min="0" step="0.01">
          </div>
          <div class="form-row">
            <label style="display:flex; align-items:center; gap:6px; cursor:pointer;">
              <input type="checkbox" id="newCatRollover" style="width:auto;">
              Roll over unused budget to next month (deficits carry forward too)
            </label>
          </div>
          <button type="submit" class="btn">Add Category</button>
        </form>
      </section>

      <section class="panel" style="margin-top:16px;">
        <h2>Backup</h2>
        <div class="btn-row">
          <button type="button" class="btn secondary" id="btnExport">Export data</button>
          <button type="button" class="btn secondary" id="btnImport">Import data</button>
        </div>
        <input type="file" id="fileInput" accept="application/json" style="display:none;">
        <div class="io-note">
          All data lives only on this device. Export a backup file regularly, and keep it somewhere safe (Files app, cloud drive) in case you switch phones or clear browser data.
        </div>
      </section>
    </div>
  </div>

  <!-- ============ TRANSACTIONS (full list for the month) ============ -->
  <div class="page" id="page-tx">
    <div class="topbar">
      <h1>Transactions</h1>
      <select class="month-select" id="monthSelectTx"></select>
    </div>
    <div style="padding:16px;">
      <section class="panel">
        <h2>This Month</h2>
        <div id="txList"></div>
      </section>
    </div>
  </div>

  <!-- ============ BOTTOM NAV ============ -->
  <nav class="bottom-nav">
    <button class="nav-item active" data-page="home"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 10.5 12 4l7 6.5V20a1 1 0 0 1-1 1h-4v-6h-4v6H6a1 1 0 0 1-1-1z" fill="currentColor" opacity="0.15"/><path d="M4 11 12 4l8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 10v9.5A1.5 1.5 0 0 0 7.5 21h9a1.5 1.5 0 0 0 1.5-1.5V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 21v-6h4v6" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span>Home</button>
    <button class="nav-item" data-page="categories"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4.379a1.5 1.5 0 0 1 1.06.44l1.122 1.12A1.5 1.5 0 0 0 12.12 8H19.5A1.5 1.5 0 0 1 21 9.5v8A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z" fill="currentColor" opacity="0.15"/><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4.379a1.5 1.5 0 0 1 1.06.44l1.122 1.12A1.5 1.5 0 0 0 12.12 8H19.5A1.5 1.5 0 0 1 21 9.5v8A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></span>Categories</button>
    <button class="nav-item" data-page="chart"><span class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="12" width="4" height="7" rx="1" fill="currentColor" opacity="0.15"/><rect x="10" y="7" width="4" height="12" rx="1" fill="currentColor" opacity="0.15"/><rect x="16" y="3" width="4" height="16" rx="1" fill="currentColor" opacity="0.15"/><rect x="4" y="12" width="4" height="7" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="10" y="7" width="4" height="12" rx="1" stroke="currentColor" stroke-width="1.4"/><rect x="16" y="3" width="4" height="16" rx="1" stroke="currentColor" stroke-width="1.4"/></svg></span>Charts</button>
  </nav>
  <button class="fab-add" id="btnAddTx">＋</button>

</div>

<!-- ============ ADD / EDIT TRANSACTION ============ -->
<div class="overlay" id="overlayTx">
  <div class="sheet">
    <div class="sheet-head">
      <h3 id="txFormTitle">Add Entry</h3>
      <button class="icon-btn" data-close="overlayTx">✕</button>
    </div>
    <form id="txForm">
      <input type="hidden" id="txId">
      <input type="hidden" id="txRecurItemId">
      <div class="form-row">
        <label>Type</label>
        <div class="seg" id="txTypeSeg">
          <button type="button" data-val="expense" class="active">Expense</button>
          <button type="button" data-val="income">Income</button>
          <button type="button" data-val="saving">Saving</button>
          <button type="button" data-val="debt">Debt</button>
        </div>
      </div>
      <div class="form-row">
        <label>Frequency</label>
        <div class="seg" id="txFreqSeg">
          <button type="button" data-val="once" class="active">One-time</button>
          <button type="button" data-val="recurring">Recurring</button>
        </div>
      </div>
      <div class="form-row">
        <label>Category</label>
        <select id="txCategory" required></select>
      </div>
      <div class="form-row" id="txDateRow">
        <label>Date</label>
        <input type="date" id="txDate">
      </div>
      <div class="form-row" id="txRecurNameRow" style="display:none;">
        <label>Name</label>
        <input type="text" id="txRecurName" placeholder="e.g. Netflix / Paycheck — defaults to category name">
      </div>
      <div class="form-row">
        <label id="txAmountLabel">Total Amount ($)</label>
        <input type="number" id="txAmount" min="0" step="0.01" required placeholder="0.00">
      </div>
      <div class="form-row" id="txPeopleRow">
        <label>People (incl. yourself — for splitting a bill)</label>
        <input type="number" id="txPeople" min="1" step="1" value="1">
        <div id="txShareHint" style="display:none; font-size:12px; color:var(--sage); margin-top:2px; font-weight:600;"></div>
      </div>
      <div class="form-row" id="txRecurDayRow" style="display:none;">
        <label>Billing Day of Month</label>
        <select id="txRecurDay" class="day-select"></select>
      </div>
      <div class="form-row" id="txRecurOverrideRow" style="display:none;">
        <label>Apply As</label>
        <div class="seg" id="txRecurModeSeg">
          <button type="button" data-val="template" class="active">From this month on (permanent)</button>
          <button type="button" data-val="override">This month only (reverts after)</button>
        </div>
      </div>
      <div class="form-row" id="txNoteRow">
        <label>Note (optional)</label>
        <input type="text" id="txNote" placeholder="e.g. Dinner with friends">
      </div>
      <div class="btn-row">
        <button type="button" class="btn secondary" id="btnStopRecurTx" style="display:none;">Stop Recurring</button>
        <button type="button" class="btn danger" id="btnDeleteTx" style="display:none;">Delete</button>
        <button type="submit" class="btn">Save</button>
      </div>
    </form>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="db.js"></script>
<script src="app.js"></script>
</body>
</html>
